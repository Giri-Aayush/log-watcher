{
  "name": "log-watcher",
  "version": "2.0.0",
  "description": "Sidecar that watches a zebrad (Zcash) node's logs and RPC, detects operator-relevant problems, and pages with a context bundle attached",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "test": "LW_TRIAGE=off node --test test/*.test.js",
    "test:regtest": "LW_REGTEST=1 node --test test/regtest.test.js",
    "demo": "node scripts/demo.js",
    "simulate": "node scripts/simulate.js"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "GPL-3.0",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.90.0",
    "express": "^4.21.2",
    "socket.io": "^4.8.1"
  }
}
